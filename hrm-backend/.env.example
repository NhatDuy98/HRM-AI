# API configuration
API_PORT=3000
API_PREFIX=/api/v1

# Swagger API documentation
SWAGGER_ENABLE=1

# Application Database
APP_DB_HOST=oracle-db
APP_DB_PORT=1521
APP_DB_USERNAME=app_user
APP_DB_PASSWORD=app_password
APP_DB_DATABASE=FREE
APP_DB_SYNCHRONIZE=false
APP_DB_ENTITIES=src/**/*.entity.ts,dist/**/*.entity.js

# Data Warehouse Database
WAREHOUSE_DB_HOST=localhost
WAREHOUSE_DB_PORT=1521
WAREHOUSE_DB_USERNAME=warehouse_user
WAREHOUSE_DB_PASSWORD=warehouse_password
WAREHOUSE_DB_DATABASE=warehouse_db
WAREHOUSE_DB_SYNCHRONIZE=false
WAREHOUSE_DB_ENTITIES=src/**/*.warehouse-entity.ts,dist/**/*.warehouse-entity.js

# JWT configuration
JWT_SECRET=ThisMustBeChanged
JWT_ISSUER=IssuerApplication
JWT_ACCESS_EXPIRATION_TIME=3d
JWT_REFRESH_EXPIRATION_TIME=30d

# Access to the health route
HEALTH_TOKEN=ThisMustBeChanged

# Domain-related configuration
PASSENGERS_ALLOWED=yes

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

SYNC_JOB_ENABLED=true

LDAP_ENABLE=false
LDAP_URL=ldap://10.3.12.57

OPEN_ELEVATION_URL=http://localhost:5202/api/v1

HTTP_TIMEOUT=5000
HTTP_MAX_REDIRECTS=5

SMART_FEATURE_URL=http://127.0.0.1:5000

BODY_LIMIT=5

BASE_URL=https://mlmt.mobifone.vn/qhtw

SSO_ISSUER_URL=https://auth-sso2fa.mobifone.vn:8080/oauth/realms/sso-mobifone/
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://mlmt.mobifone.vn/qhtw/login/callback