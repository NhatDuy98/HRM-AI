{
  "compilerOptions": {
    "module": "commonjs", // Required for Node.js compatibility
    "moduleResolution": "node", // Ensures module resolution works with Node.js
    "declaration": false,
    "noImplicitAny": true,
    "removeComments": true,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2020",
    "sourceMap": true,
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./src", // Specifies the root directory for source files
    "resolveJsonModule": true, // Required for pinia package
    "esModuleInterop": true, // Provides better compatibility with CommonJS modules (Required for pinia package)
    "strictNullChecks": true,
    "noUnusedLocals": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts", "./migrations"]
}
