{
  "name": "nest-template",
  "version": "0.1.0",
  "description": "NestJS API project template crafted for Docker environments",
  "author": "Saluki",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "start": "node dist/server.js",
    "dev": "env-cmd -f .env nodemon",
    "start:dev": "npm run dev",
    "build": "tsc",
    "test": "env-cmd -f .env jest --config=jest.json",
    "lint": "eslint -c .eslintrc.js --ext .ts 'src/**/*.ts'",
    "start:debug": "env-cmd -f .env nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "typeorm": "ts-node ./node_modules/typeorm/cli",
    "migration:create": "npm run typeorm -- migration:create ./migrations/$npm_config_name",
    "migration:generate": "npm run build && npm run typeorm -- migration:generate dist/migrations/$npm_config_name -d ./dist/typeOrm.config.js",
    "migration:run": "npm run typeorm migration:run -- -d ./dist/typeOrm.config.js",
    "migration:revert": "npm run typeorm migration:revert -- -d ./dist/typeOrm.config.js",
    "seed": "ts-node ./src/database/run-seed.ts",
    "seed:dghc": "ts-node -r tsconfig-paths/register ./src/seed.ts dghc",
    "seed:general": "ts-node -r tsconfig-paths/register ./src/seed.ts general"
  },
  "dependencies": {
    "@fastify/busboy": "^3.0.0",
    "@fastify/compress": "^7.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^8.0.1",
    "@fastify/static": "^7.0.4",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/bullmq": "^10.2.2",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-fastify": "^10.4.6",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@nestjs/typeorm": "^10.0.2",
    "@placemarkio/tokml": "^0.3.7",
    "@prisma/client": "^5.21.1",
    "@tmcw/togeojson": "^5.8.1",
    "@turf/turf": "^7.2.0",
    "@types/bcrypt": "^5.0.2",
    "@types/supercluster": "^7.1.3",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.26.2",
    "busboy": "^0.3.1",
    "cache-manager": "^5.7.6",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^5.6.0",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.1.0",
    "fs-extra": "^11.3.0",
    "gdal-async": "^3.10.2",
    "geojson": "^0.5.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "ldap-authentication": "^3.2.4",
    "ldapjs": "^3.0.7",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "nest-file-fastify": "^3.0.7",
    "node-cron": "^3.0.3",
    "openid-client": "^5.6.5",
    "oracledb": "^6.7.0",
    "p-limit": "^3.1.0",
    "pg": "^8.17.1",
    "piscina": "^4.8.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supercluster": "^8.0.1",
    "typeorm": "^0.3.20",
    "unzipper": "^0.12.3",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/ldapjs": "^2.2.5",
    "@types/lodash": "^4.17.13",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.8.1",
    "@types/oracledb": "^6.5.2",
    "@types/supertest": "^6.0.2",
